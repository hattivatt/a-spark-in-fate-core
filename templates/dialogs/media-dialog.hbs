<div class="spark-dialog">
  <div class="form-group">
    <label>{{localize "a-spark-in-fate-core.Title"}}</label>
    <input type="text" name="title" value="{{title}}" placeholder="{{localize 'a-spark-in-fate-core.MediaTitlePlaceholder'}}" autofocus>
  </div>
  <div class="form-group">
    <label>{{localize "a-spark-in-fate-core.MediaContributor"}}</label>
    <select name="userId">
      {{#each users}}
        <option value="{{this.id}}" {{#if (eq this.id ../selectedUserId)}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "a-spark-in-fate-core.Image"}}</label>
    <input type="text" name="image" value="{{image}}" placeholder="{{localize 'a-spark-in-fate-core.ImagePlaceholder'}}">
  </div>
  <div class="form-group">
    <label>{{localize "a-spark-in-fate-core.MediaDescription"}}</label>
    <textarea name="description" rows="3" placeholder="{{localize 'a-spark-in-fate-core.MediaDescriptionPlaceholder'}}">{{description}}</textarea>
  </div>
  <div class="dialog-buttons">
    <button type="button" class="save" data-action="save">{{localize "a-spark-in-fate-core.Save"}}</button>
    <button type="button" class="cancel" data-action="close">{{localize "a-spark-in-fate-core.Cancel"}}</button>
  </div>
</div>
